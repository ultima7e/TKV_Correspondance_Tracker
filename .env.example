# Copy to .env (gitignored) for local dev, and set the same vars in the Vercel
# project's Environment Variables. Run locally with:  npm run dev:cloud

# --- Nutstore (WebDAV) — where LetterTracker_Data.json lives ---
# Create an app password in Nutstore (安全选项 → 第三方应用管理) — do NOT use
# your main account password.
NUTSTORE_USER=you@example.com
NUTSTORE_PASSWORD=your-nutstore-app-password
# Optional: override the path to the data file inside the WebDAV root.
# Default: "Shared Folder/Letter Recording/LetterTracker_Data.json"
# NUTSTORE_LETTERS_PATH=Shared Folder/Letter Recording/LetterTracker_Data.json

# --- Session signing (any long random string) ---
AUTH_SECRET=change-me-to-a-long-random-string

# --- Bootstrap admin (works before any KV store is connected) ---
# Lets you log in as an admin the very first time so you can create real users.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# --- Upstash Redis / Vercel KV (needed to persist users you create) ---
# Provisioned in Vercel: Storage → Create → Upstash for Redis → Connect.
# Auto-adds these; locally, leave unset to use the data/.users.json fallback.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
